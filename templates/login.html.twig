<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion - {{ app_name }}</title>
    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            50: '#f5f3ff',
                            100: '#ede9fe',
                            200: '#ddd6fe',
                            300: '#c4b5fd',
                            400: '#a78bfa',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                            800: '#5b21b6',
                            900: '#4c1d95',
                        }
                    }
                }
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
    <link rel="manifest" href="{{ url('/manifest.json') }}">
    <meta name="theme-color" content="#7c3aed">
    <link rel="apple-touch-icon" href="{{ url('/public/icons/icon-192x192.png') }}">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register("{{ url('/sw.js') }}");
            });
        }
    </script>
</head>
<body class="bg-slate-900 min-h-screen flex items-center justify-center p-4 relative overflow-hidden font-sans">
    <!-- Background decoration -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
        <div class="absolute top-[-10%] right-[-10%] w-96 h-96 bg-primary-600/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-[-10%] left-[-10%] w-96 h-96 bg-blue-600/20 rounded-full blur-3xl"></div>
    </div>
    <div class="w-full max-w-md relative z-10">
        <div class="bg-white rounded-3xl shadow-2xl p-6 sm:p-10 border border-white/10">
            <!-- Logo & Title -->
            <div class="text-center mb-8">
                <div class="flex items-center justify-center gap-4 mb-2">
                    <div class="w-12 h-12 bg-gradient-to-br from-primary-600 to-indigo-600 rounded-xl flex items-center justify-center shadow-lg shadow-primary-500/30 transform rotate-3">
                        <i data-lucide="shield-check" class="w-6 h-6 text-white"></i>
                    </div>
                    <h1 class="text-3xl font-bold text-slate-800">{{ app_name }}</h1>
                </div>
            </div>

            <!-- Message d'erreur -->
            {% if error %}
            <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-xl flex items-center gap-3">
                <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 flex-shrink-0"></i>
                <span class="text-red-800 text-sm font-medium">{{ error }}</span>
            </div>
            {% endif %}

            <!-- Formulaire -->
            <form id="loginForm" method="POST" action="{{ url('/login') }}" class="space-y-8">
                <input type="hidden" id="password" name="password">
                
                <!-- Indicateurs de code -->
                <div class="flex justify-center gap-4 mb-8">
                    <div class="code-dot w-4 h-4 rounded-full border-2 border-slate-300"></div>
                    <div class="code-dot w-4 h-4 rounded-full border-2 border-slate-300"></div>
                    <div class="code-dot w-4 h-4 rounded-full border-2 border-slate-300"></div>
                    <div class="code-dot w-4 h-4 rounded-full border-2 border-slate-300"></div>
                </div>

                {% if not is_blocked %}
                <!-- Pavé numérique -->
                <div class="grid grid-cols-3 gap-4 max-w-[280px] mx-auto">
                    {% for i in 1..9 %}
                    <button type="button" onclick="appendNumber('{{ i }}')" 
                            class="w-16 h-16 rounded-2xl bg-slate-50 text-2xl font-bold text-slate-700 hover:bg-primary-500 hover:text-white transition-all transform active:scale-90 flex items-center justify-center shadow-sm border border-slate-100">
                        {{ i }}
                    </button>
                    {% endfor %}
                    <div class="w-16 h-16"></div> <!-- Placeholder -->
                    <button type="button" onclick="appendNumber('0')" 
                            class="w-16 h-16 rounded-2xl bg-slate-50 text-2xl font-bold text-slate-700 hover:bg-primary-500 hover:text-white transition-all transform active:scale-90 flex items-center justify-center shadow-sm border border-slate-100">
                        0
                    </button>
                    <button type="button" onclick="clearCode()" 
                            class="w-16 h-16 rounded-2xl bg-slate-50 text-slate-400 hover:bg-red-50 hover:text-red-500 transition-all transform active:scale-90 flex items-center justify-center shadow-sm border border-slate-100">
                        <i data-lucide="delete" class="w-6 h-6"></i>
                    </button>
                </div>
                {% else %}
                <div class="text-center py-6">
                    <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i data-lucide="lock" class="w-10 h-10 text-red-600"></i>
                    </div>
                    <p class="text-slate-600 font-medium">Accès bloqué temporairement</p>
                    <p class="text-slate-400 text-sm mt-1">Réessayez dans <span id="countdown">{{ blocked_time }}</span>s</p>
                </div>
                <script>
                    let timeRemaining = {{ blocked_time }};
                    const countdownEl = document.getElementById('countdown');
                    const timer = setInterval(() => {
                        timeRemaining--;
                        if (timeRemaining <= 0) {
                            clearInterval(timer);
                            window.location.reload();
                        }
                        countdownEl.textContent = timeRemaining;
                    }, 1000);
                </script>
                {% endif %}
            </form>
        </div>

        <style>
            .code-dot.active {
                background-color: #8b5cf6;
                border-color: #8b5cf6;
                box-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
                transform: scale(1.1);
            }
        </style>

        <script>
            let currentCode = '';
            const dots = document.querySelectorAll('.code-dot');
            const passwordInput = document.getElementById('password');
            const form = document.getElementById('loginForm');

            function appendNumber(num) {
                if (currentCode.length < 4) {
                    currentCode += num;
                    updateUI();
                    
                    if (currentCode.length === 4) {
                        passwordInput.value = currentCode;
                        setTimeout(() => form.submit(), 200);
                    }
                }
            }

            function clearCode() {
                currentCode = '';
                updateUI();
            }

            function updateUI() {
                dots.forEach((dot, index) => {
                    if (index < currentCode.length) {
                        dot.classList.add('active');
                    } else {
                        dot.classList.remove('active');
                    }
                });
            }

            // Keyboard support
            document.addEventListener('keydown', (e) => {
                if (e.key >= '0' && e.key <= '9') {
                    appendNumber(e.key);
                } else if (e.key === 'Backspace') {
                    currentCode = currentCode.slice(0, -1);
                    updateUI();
                } else if (e.key === 'Escape') {
                    clearCode();
                }
            });
        </script>

        <!-- Footer -->
        <p class="text-center text-slate-500 text-sm mt-8">
            © {{ "now"|date("Y") }} {{ app_name }}
        </p>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
