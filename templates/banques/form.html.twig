{% extends 'base.html.twig' %}

{% block content %}
<div class="max-w-2xl mx-auto">
    <div class="mb-6 flex items-center gap-4">
        <a href="{{ url('/banques') }}" class="p-2 rounded-lg hover:bg-white text-gray-500 hover:text-gray-900 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <h2 class="text-2xl font-bold text-gray-900">
            {% if banque %}Modifier {{ banque.nom }}{% else %}Ajouter une banque{% endif %}
        </h2>
    </div>

    <form method="POST" action="{{ banque ? url('/banques/' ~ banque.id ~ '/edit') : url('/banques/create') }}" class="bg-white rounded-2xl shadow-sm p-6 space-y-6">
        
        <div>
            <label for="nom" class="block text-sm font-medium text-gray-700 mb-1">Nom de la banque</label>
            <input type="text" name="nom" id="nom" required
                   value="{{ banque.nom ?? '' }}"
                   class="block w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm p-2.5 border">
        </div>

        <div>
            <label for="logo_url" class="block text-sm font-medium text-gray-700 mb-1">URL du logo (optionnel)</label>
            <input type="url" name="logo_url" id="logo_url"
                   value="{{ banque.logo_url ?? '' }}"
                   placeholder="https://..."
                   class="block w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm p-2.5 border">
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Couleur</label>
            <div class="flex gap-3 flex-wrap">
                {% for color in ['#6366F1', '#EF4444', '#F59E0B', '#10B981', '#3B82F6', '#8B5CF6', '#EC4899', '#6B7280', '#000000'] %}
                <label class="cursor-pointer">
                    <input type="radio" name="couleur" value="{{ color }}" class="sr-only peer"
                           {% if (banque.couleur ?? '#6366F1') == color %}checked{% endif %}>
                    <div class="w-8 h-8 rounded-full border-2 border-transparent peer-checked:border-gray-900 peer-checked:scale-110 transition-all flex items-center justify-center"
                         style="background-color: {{ color }}">
                         <i data-lucide="check" class="w-4 h-4 text-white opacity-0 peer-checked:opacity-100"></i>
                    </div>
                </label>
                {% endfor %}
            </div>
        </div>

        <div class="flex justify-end pt-4">
            <button type="submit" class="inline-flex items-center px-6 py-2.5 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                {% if banque %}Enregistrer les modifications{% else %}Créer la banque{% endif %}
            </button>
        </div>
    </form>
</div>
{% endblock %}
